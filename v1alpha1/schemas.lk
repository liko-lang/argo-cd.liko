        conditions?: [{
            lastTransitionTime?: string
            message: string
            reason: string
            status: string
            type: string
        }]
        health?: {
            lastTransitionTime?: string
            message?: string
            status?: string
        }
        resources?: [{
            group?: string
            health?: {
                lastTransitionTime?: string
                message?: string
                status?: string
            }
            hook?: bool
            kind?: string
            name?: string
            namespace?: string
            requiresDeletionConfirmation?: bool
            requiresPruning?: bool
            status?: string
            syncWave?: int
            version?: string
        }]
        resourcesCount?: int
    }
}
